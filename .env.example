SGO_API_KEY=

# ---- Free (Amateur) plan settings ----
# The free plan allows 10 requests/minute, 2,500 games per month, and odds that refresh every 10 minutes.
# These settings stay under the request limit, but the monthly allowance still runs out in a few days.
SGO_LEAGUES=NHL,NBA
SGO_LIVE=0
PREGAME_POLL_MS=900000

# ---- Paid plan settings (uncomment when you upgrade) ----
# SGO_LEAGUES=NFL,NBA,NHL,MLB,NCAAF,NCAAB,MLS
# SGO_LIVE=1
# LIVE_POLL_MS=5000
# PREGAME_POLL_MS=30000

FLUSH_MS=250
PORT=8787
