{
  "name": "1xodds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "build:demo": "DEMO_SINGLEFILE=1 vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx scripts/engine-test.ts",
    "typecheck": "tsc --noEmit -p .",
    "probe:sgo": "tsx scripts/probe-sgo.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
